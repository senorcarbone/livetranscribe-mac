#!/usr/bin/env bash
# One-time setup: install dependencies and fetch models (~8.4 GB).
# Safe to re-run — it skips whatever is already in place.
set -uo pipefail

MODELS="${WHISPER_MODELS:-$HOME/.whisper-models}"
BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

echo "${BOLD}1/3  Checking Homebrew packages${RESET}"
command -v brew >/dev/null || {
  echo "Homebrew is required: https://brew.sh" >&2; exit 1; }
for pkg in ffmpeg whisper-cpp llama.cpp; do
  if brew list "$pkg" >/dev/null 2>&1; then
    echo "  ${DIM}already installed:${RESET} $pkg"
  else
    echo "  installing $pkg…"
    brew install "$pkg" || { echo "  failed to install $pkg" >&2; exit 1; }
  fi
done
for b in ffmpeg whisper-cli llama-server; do
  command -v "$b" >/dev/null || { echo "  missing binary after install: $b" >&2; exit 1; }
done

echo "${BOLD}2/3  Fetching models into $MODELS${RESET}"
mkdir -p "$MODELS"

# HuggingFace throttles a long-lived anonymous connection down to almost nothing
# after about a minute, but a resumed request starts fast again. So reconnect in
# a loop rather than trusting a single curl to finish.
fetch() {                       # fetch <url> <filename> <expected-bytes>
  local url="$1" name="$2" want="$3" path="$MODELS/$2"
  local have stall=0 before
  have=$(stat -f%z "$path" 2>/dev/null || echo 0)
  if [ "$have" -eq "$want" ]; then
    echo "  ${DIM}already have:${RESET} $name"
    return 0
  fi
  [ "$have" -gt "$want" ] && { echo "  $name is larger than expected — delete it and re-run" >&2; return 1; }
  echo "  downloading $name ($(( want/1048576 )) MB)…"
  while :; do
    before=$(stat -f%z "$path" 2>/dev/null || echo 0)
    [ "$before" -ge "$want" ] && break
    curl -fSL -C - --max-time 90 --retry 3 --retry-all-errors -o "$path" "$url" >/dev/null 2>&1
    have=$(stat -f%z "$path" 2>/dev/null || echo 0)
    printf '\r    %s / %s MB   ' "$((have/1048576))" "$((want/1048576))"
    if [ "$have" -le "$before" ]; then
      stall=$((stall+1))
      [ "$stall" -ge 8 ] && { echo; echo "  stalled repeatedly on $name — check your connection and re-run" >&2; return 1; }
      sleep 3
    else
      stall=0
    fi
  done
  echo
  [ "$(stat -f%z "$path")" -eq "$want" ] || { echo "  $name finished at the wrong size" >&2; return 1; }
  echo "    done"
}

W=https://huggingface.co/ggerganov/whisper.cpp/resolve/main
V=https://huggingface.co/ggml-org/whisper-vad/resolve/main
G=https://huggingface.co/ggml-org/gemma-3-12b-it-GGUF/resolve/main

fetch "$W/ggml-large-v3-turbo-q5_0.bin" ggml-large-v3-turbo-q5_0.bin 574041195 || exit 1
fetch "$V/ggml-silero-v5.1.2.bin"       ggml-silero-v5.1.2.bin          885098 || exit 1
fetch "$G/gemma-3-12b-it-Q4_K_M.gguf"   gemma-3-12b-it-Q4_K_M.gguf   7300574976 || exit 1

echo "${BOLD}3/3  Optional${RESET}"
echo "  ${DIM}ggml-large-v3-q5_0.bin (1.0 GB) is only needed for the legacy -w mode.${RESET}"
echo "  ${DIM}Fetch it with:${RESET}"
echo "    curl -fSL -C - -o \"$MODELS/ggml-large-v3-q5_0.bin\" \\"
echo "      $W/ggml-large-v3-q5_0.bin"
echo
echo "${BOLD}Ready.${RESET} Next steps:"
echo "  1. Grant your terminal microphone access:"
echo "     System Settings > Privacy & Security > Microphone"
echo "  2. Do a 30-second test, then check the recording:"
echo "     $(dirname "$0")/livetranscribe -E"
echo "     $(dirname "$0")/lt-checkaudio"
