#!/usr/bin/env bash
# Check a recording for the capture defects we fixed.
# Usage: lt-checkaudio [file.wav]   (defaults to the most recent meeting)
set -uo pipefail
F="${1:-}"
if [ -z "$F" ]; then
  BASE="${LT_OUTDIR:-$HOME/Documents/livetranscribe}"
  F=$(ls -t "$BASE"/*/full_audio.wav 2>/dev/null | head -1)
  [ -z "$F" ] && { echo "No recordings found. Pass a .wav explicitly." >&2; exit 1; }
fi
[ -s "$F" ] || { echo "No such file: $F" >&2; exit 1; }
echo "Checking $F"
python3 - "$F" <<'PY'
import struct, os, sys, wave, numpy as np
p=sys.argv[1]; size=os.path.getsize(p)
riffsz=struct.unpack("<I", open(p,'rb').read(8)[4:])[0]
hdr_ok = riffsz == size-8
print(f"  header      : RIFF {riffsz} vs {size-8} -> {'OK' if hdr_ok else 'UNFINALISED (file was killed mid-write)'}")

w=wave.open(p); sr=w.getframerate()
x=np.frombuffer(w.readframes(w.getnframes()),dtype=np.int16).astype(np.float64)
print(f"  duration    : {len(x)/sr:.1f}s at {sr} Hz")
rms=np.sqrt((x**2).mean())
print(f"  level       : rms {rms:.0f}, peak {np.abs(x).max():.0f}" + ("   <-- SILENT" if rms<1 else ""))
if rms < 1: raise SystemExit

d=np.abs(np.diff(x)); loc=np.convolve(d,np.ones(64)/64,mode='same')
sp=np.where(d>np.maximum(loc*12,300))[0]
print(f"  clicks      : {len(sp)} discontinuities")
worst=0; worstB=0
for B in (512,1024,2048):
    if len(sp)<8: break
    conc=np.bincount(sp%B,minlength=B).max()/len(sp)
    ratio=conc*B
    if ratio>worst: worst, worstB = ratio, B
if len(sp)>=8:
    print(f"  periodicity : clicks cluster {worst:.0f}x more than chance on {worstB}-sample boundaries")
    print("                -> BUZZ PRESENT: resampling glitch in the capture path" if worst>20
          else "                -> no buffer-boundary buzz")
else:
    print("  periodicity : too few clicks to be a buzz -> clean")
PY
